{
  "name": "@scalable.software/taskbar",
  "version": "0.0.1",
  "description": "A theme-aware web component that holds the controls of a window in one bar, and reports what the end user asks of them as its own events.",
  "keywords": [
    "web component"
  ],
  "files": [
    "dist",
    "!dist/.gitkeep"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "clean.test": "node ./tasks/clean.test.mjs",
    "check.specification": "node ./tasks/check.specification.mjs",
    "pretest": "npm run clean.test && npm run check.specification && tsc --project tsconfig.test.json",
    "test": "karma start",
    "posttest": "npm run clean.test",
    "prebuild": "node ./tasks/clean.build.mjs",
    "build": "tsc --project tsconfig.build.json",
    "postbuild": "node ./tasks/copy.build.mjs",
    "preserve": "npm run build",
    "serve": "web-dev-server --open /demo/index.html",
    "document": "npx typedoc --tsconfig tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalable-software/taskbar.git"
  },
  "author": "Scalable.Software",
  "license": "CC-BY-NC-SA-4.0",
  "bugs": {
    "url": "https://github.com/scalable-software/taskbar/issues"
  },
  "homepage": "https://github.com/scalable-software/taskbar#readme",
  "devDependencies": {
    "@scalable.software/pin": "^0.3.0",
    "@types/jasmine": "^5.1.4",
    "@web/dev-server": "^0.4.6",
    "ajv": "^8.20.0",
    "jasmine": "^5.1.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-instrumenter": "^1.0.4",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-spec-reporter": "^0.0.36",
    "typedoc": "^0.28.20",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@scalable.software/component": "^0.7.0"
  }
}
